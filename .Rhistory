shapiro_residuos$statistic, shapiro_residuos$p.value))
if (shapiro_residuos$p.value > 0.04) {
cat("Conclusión: Los residuos siguen una distribución normal (α = 0.04)\n")
} else {
cat("Conclusión: Los residuos NO siguen una distribución normal (α = 0.04)\n")
}
cat("=== RESULTADOS DEL ANOVA ===\n\n")
cat(sprintf("F-estadístico = %.4f\n", F_stat))
cat(sprintf("p-valor = %.6f\n", p_valor))
cat(sprintf("Nivel de significancia: α = 0.04\n\n"))
if (p_valor < 0.04) {
cat("DECISIÓN: Rechazamos la hipótesis nula (H₀)\n\n")
cat("CONCLUSIÓN: Existen diferencias estadísticamente significativas en las horas de sueño\n")
cat("promedio entre al menos dos de los grupos de uso nocturno de redes sociales.\n\n")
cat("Esto significa que el nivel de uso nocturno de redes sociales SÍ tiene un efecto\n")
cat("significativo sobre la cantidad de horas de sueño de los estudiantes universitarios.\n")
} else {
cat("DECISIÓN: No rechazamos la hipótesis nula (H₀)\n\n")
cat("CONCLUSIÓN: No existe evidencia estadística suficiente para afirmar que hay diferencias\n")
cat("significativas en las horas de sueño promedio entre los grupos de uso nocturno de redes.\n")
}
for (i in 1:nrow(tukey_tabla)) {
comp <- tukey_tabla[i, ]
cat(sprintf("\n• %s:\n", comp$Comparacion))
cat(sprintf("  Diferencia de medias: %.3f horas\n", comp$`Diferencia de Medias`))
cat(sprintf("  IC 96%%: [%.3f, %.3f]\n", comp$`Límite Inferior (96%)`, comp$`Límite Superior (96%)`))
cat(sprintf("  p-valor ajustado: %.4f\n", comp$`p-valor ajustado`))
if (comp$`¿Significativo?` == "Sí") {
if (comp$`Diferencia de Medias` > 0) {
grupos <- strsplit(comp$Comparacion, "-")[[1]]
cat(sprintf("  → El grupo '%s' duerme significativamente MÁS que '%s'\n",
trimws(grupos[1]), trimws(grupos[2])))
} else {
grupos <- strsplit(comp$Comparacion, "-")[[1]]
cat(sprintf("  → El grupo '%s' duerme significativamente MENOS que '%s'\n",
trimws(grupos[1]), trimws(grupos[2])))
}
} else {
cat("  → No hay diferencia significativa entre estos grupos\n")
}
}
# Cargar librerías necesarias
library(readr)
library(dplyr)
library(ggplot2)
library(knitr)
library(kableExtra)
library(car)        # Para VIF y pruebas de supuestos
library(lmtest)     # Para pruebas adicionales de regresión
library(tidyr)
# Leer la muestra de datos
DF <- read_csv("muestra.csv", col_types = cols(.default = "c"))
# Convertir tipos de datos según especificaciones del proyecto
DF <- DF %>%
mutate(
# Cuantitativas discretas
edad = as.integer(edad),
total_cursos_actuales = as.integer(total_cursos_actuales),
horas_ejercicio_semanal = as.integer(horas_ejercicio_semanal),
horas_sueño_xnoche = as.integer(horas_sueño_xnoche),
tiempo_max_sin_redes_dia = as.integer(tiempo_max_sin_redes_dia),
notificaciones_estudio_diario = as.integer(notificaciones_estudio_diario),
dias_redes_antes_de_dormir = as.integer(dias_redes_antes_de_dormir),
interaccion_persona_amigos_redes = as.integer(interaccion_persona_amigos_redes),
# Cuantitativas continuas
prom_estudio_dia = as.numeric(prom_estudio_dia),
prom_ciclo_pasado = as.numeric(prom_ciclo_pasado),
# Cualitativas nominales
sexo = factor(sexo, levels = c("Femenino", "Masculino")),
tipo_universidad = factor(tipo_universidad, levels = c("Privada", "Pública")),
actividad_extracurricular_actual = factor(actividad_extracurricular_actual),
red_mas_usada = factor(red_mas_usada),
tipo_contenido_redes_sociales = factor(tipo_contenido_redes_sociales,
levels = c("Académico", "Entretenimiento", "Noticias", "Socializar")),
uso_redes_academicas = factor(uso_redes_academicas, levels = c("No", "Sí")),
impacto_redes_actividades_extracurriculares = factor(impacto_redes_actividades_extracurriculares,
levels = c("Desmotiva", "Motiva", "No tiene efecto")),
momento_uso_redes_sociales = factor(momento_uso_redes_sociales),
# Cualitativas ordinales (escalas 1-5)
afecta_concentracion_rendimiento = factor(afecta_concentracion_rendimiento,
levels = c("1", "2", "3", "4", "5"), ordered = TRUE),
impacto_redes_salud_mental = factor(impacto_redes_salud_mental,
levels = c("1", "2", "3", "4", "5"), ordered = TRUE),
satisfaccion_interaccion_social_presencial = factor(satisfaccion_interaccion_social_presencial,
levels = c("1", "2", "3", "4", "5"), ordered = TRUE),
satisfaccion_rendimiento_academico = factor(satisfaccion_rendimiento_academico,
levels = c("1", "2", "3", "4", "5"), ordered = TRUE),
frecuencia_descubrimiento_actividades_redes = factor(frecuencia_descubrimiento_actividades_redes,
levels = c("1", "2", "3", "4", "5"), ordered = TRUE),
ciclo = factor(as.character(ciclo), levels = as.character(1:10), ordered = TRUE)
)
# Verificar estructura de datos
cat("Dimensiones del dataset:", nrow(DF), "filas x", ncol(DF), "columnas\n")
cat("Total de observaciones válidas para análisis:",
sum(complete.cases(DF[, c("prom_ciclo_pasado", "prom_estudio_dia",
"horas_sueño_xnoche", "horas_ejercicio_semanal",
"dias_redes_antes_de_dormir")])), "\n")
# Crear dataset limpio solo con variables del modelo
datos_regresion <- DF %>%
select(prom_ciclo_pasado, prom_estudio_dia, horas_sueño_xnoche,
horas_ejercicio_semanal, dias_redes_antes_de_dormir) %>%
filter(complete.cases(.))
# Estadísticas descriptivas
estadisticas <- datos_regresion %>%
summarise(
across(everything(),
list(media = ~mean(., na.rm = TRUE),
mediana = ~median(., na.rm = TRUE),
sd = ~sd(., na.rm = TRUE),
min = ~min(., na.rm = TRUE),
max = ~max(., na.rm = TRUE)),
.names = "{.col}_{.fn}")
)
# Transponer para mejor visualización
estadisticas_t <- data.frame(
Variable = c("Promedio académico", "Horas estudio/día", "Horas sueño/noche",
"Horas ejercicio/semana", "Días redes antes dormir"),
Media = c(estadisticas$prom_ciclo_pasado_media, estadisticas$prom_estudio_dia_media,
estadisticas$horas_sueño_xnoche_media, estadisticas$horas_ejercicio_semanal_media,
estadisticas$dias_redes_antes_de_dormir_media),
Mediana = c(estadisticas$prom_ciclo_pasado_mediana, estadisticas$prom_estudio_dia_mediana,
estadisticas$horas_sueño_xnoche_mediana, estadisticas$horas_ejercicio_semanal_mediana,
estadisticas$dias_redes_antes_de_dormir_mediana),
Desv_Est = c(estadisticas$prom_ciclo_pasado_sd, estadisticas$prom_estudio_dia_sd,
estadisticas$horas_sueño_xnoche_sd, estadisticas$horas_ejercicio_semanal_sd,
estadisticas$dias_redes_antes_de_dormir_sd),
Mínimo = c(estadisticas$prom_ciclo_pasado_min, estadisticas$prom_estudio_dia_min,
estadisticas$horas_sueño_xnoche_min, estadisticas$horas_ejercicio_semanal_min,
estadisticas$dias_redes_antes_de_dormir_min),
Máximo = c(estadisticas$prom_ciclo_pasado_max, estadisticas$prom_estudio_dia_max,
estadisticas$horas_sueño_xnoche_max, estadisticas$horas_ejercicio_semanal_max,
estadisticas$dias_redes_antes_de_dormir_max)
)
kable(estadisticas_t, digits = 2,
caption = "Tabla 1: Estadísticas descriptivas de las variables del modelo de regresión",
col.names = c("Variable", "Media", "Mediana", "Desv. Est.", "Mínimo", "Máximo")) %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed", "responsive"),
full_width = TRUE, font_size = 12) %>%
row_spec(0, bold = TRUE, color = "white", background = "#3498db")
# Matriz de correlación
correlaciones <- cor(datos_regresion, use = "complete.obs")
# Visualización de correlaciones
library(corrplot)
corrplot(correlaciones, method = "number", type = "upper",
tl.col = "black", tl.srt = 45, number.cex = 0.8,
title = "Matriz de Correlaciones entre Variables",
mar = c(0,0,2,0))
# Gráficos de dispersión para cada predictor vs variable dependiente
p1 <- ggplot(datos_regresion, aes(x = prom_estudio_dia, y = prom_ciclo_pasado)) +
geom_point(alpha = 0.5, color = "#3498db") +
geom_smooth(method = "lm", se = TRUE, color = "#e74c3c") +
labs(title = "Promedio Académico vs Horas de Estudio",
x = "Horas de estudio por día", y = "Promedio académico") +
theme_minimal()
p2 <- ggplot(datos_regresion, aes(x = horas_sueño_xnoche, y = prom_ciclo_pasado)) +
geom_point(alpha = 0.5, color = "#3498db") +
geom_smooth(method = "lm", se = TRUE, color = "#e74c3c") +
labs(title = "Promedio Académico vs Horas de Sueño",
x = "Horas de sueño por noche", y = "Promedio académico") +
theme_minimal()
p3 <- ggplot(datos_regresion, aes(x = horas_ejercicio_semanal, y = prom_ciclo_pasado)) +
geom_point(alpha = 0.5, color = "#3498db") +
geom_smooth(method = "lm", se = TRUE, color = "#e74c3c") +
labs(title = "Promedio Académico vs Horas de Ejercicio",
x = "Horas de ejercicio por semana", y = "Promedio académico") +
theme_minimal()
p4 <- ggplot(datos_regresion, aes(x = dias_redes_antes_de_dormir, y = prom_ciclo_pasado)) +
geom_point(alpha = 0.5, color = "#3498db") +
geom_smooth(method = "lm", se = TRUE, color = "#e74c3c") +
labs(title = "Promedio Académico vs Uso Nocturno de Redes",
x = "Días/semana usando redes antes de dormir", y = "Promedio académico") +
theme_minimal()
# Mostrar en grid
library(gridExtra)
grid.arrange(p1, p2, p3, p4, ncol = 2)
# Ajustar modelo de regresión lineal múltiple
modelo_reg <- lm(prom_ciclo_pasado ~ prom_estudio_dia + horas_sueño_xnoche +
horas_ejercicio_semanal + dias_redes_antes_de_dormir,
data = datos_regresion)
# Resumen del modelo
summary(modelo_reg)
coefs <- coef(modelo_reg)
cat("Ecuación de regresión estimada:\n\n")
cat(sprintf("Promedio_Académico = %.4f + %.4f × Horas_Estudio + %.4f × Horas_Sueño\n",
coefs[1], coefs[2], coefs[3]))
cat(sprintf("                     + %.4f × Horas_Ejercicio + %.4f × Días_Redes_Noche\n",
coefs[4], coefs[5]))
# Intervalos de confianza para los coeficientes al 96%
ic_coef <- confint(modelo_reg, level = 0.96)
ic_tabla <- data.frame(
Coeficiente = c("Intercepto", "Horas estudio/día", "Horas sueño/noche",
"Horas ejercicio/semana", "Días redes antes dormir"),
Estimacion = coefs,
Limite_Inferior = ic_coef[, 1],
Limite_Superior = ic_coef[, 2]
)
kable(ic_tabla, digits = 4,
caption = "Tabla 2: Coeficientes del modelo con intervalos de confianza al 96%",
col.names = c("Coeficiente", "Estimación", "Límite Inferior (96%)", "Límite Superior (96%)")) %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"),
full_width = FALSE, font_size = 12) %>%
row_spec(0, bold = TRUE, color = "white", background = "#3498db")
# Gráficos de diagnóstico estándar
par(mfrow = c(2, 2))
plot(modelo_reg, which = 1:4)
# Prueba de Shapiro-Wilk para normalidad de residuos
shapiro_test <- shapiro.test(residuals(modelo_reg))
cat("Prueba de Shapiro-Wilk para normalidad de residuos:\n")
cat(sprintf("Estadístico W = %.4f, p-valor = %.4f\n",
shapiro_test$statistic, shapiro_test$p.value))
if (shapiro_test$p.value > 0.04) {
cat("Conclusión: No rechazamos H₀. Los residuos siguen una distribución normal (α = 0.04)\n")
} else {
cat("Conclusión: Rechazamos H₀. Los residuos NO siguen una distribución normal (α = 0.04)\n")
}
# Prueba de Breusch-Pagan
bp_test <- bptest(modelo_reg)
cat("Prueba de Breusch-Pagan para homocedasticidad:\n")
cat(sprintf("Estadístico BP = %.4f, p-valor = %.4f\n",
bp_test$statistic, bp_test$p.value))
if (bp_test$p.value > 0.04) {
cat("Conclusión: No rechazamos H₀. La varianza de los residuos es constante (α = 0.04)\n")
} else {
cat("Conclusión: Rechazamos H₀. Existe heterocedasticidad (α = 0.04)\n")
}
# Factor de Inflación de la Varianza (VIF)
vif_values <- vif(modelo_reg)
vif_tabla <- data.frame(
Variable = names(vif_values),
VIF = vif_values
)
kable(vif_tabla, digits = 2,
caption = "Tabla 3: Factores de Inflación de la Varianza (VIF)",
col.names = c("Variable", "VIF")) %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"),
full_width = FALSE, font_size = 12) %>%
row_spec(0, bold = TRUE, color = "white", background = "#3498db")
cat("\nInterpretación:\n")
cat("- VIF < 5: No hay problema de multicolinealidad\n")
cat("- VIF entre 5-10: Multicolinealidad moderada\n")
cat("- VIF > 10: Multicolinealidad severa\n")
# Prueba de Durbin-Watson
dw_test <- durbinWatsonTest(modelo_reg)
cat("Prueba de Durbin-Watson para independencia de residuos:\n")
cat(sprintf("Estadístico DW = %.4f, p-valor = %.4f\n",
dw_test$dw, dw_test$p))
if (dw_test$p > 0.04) {
cat("Conclusión: No hay evidencia de autocorrelación en los residuos (α = 0.04)\n")
} else {
cat("Conclusión: Existe autocorrelación en los residuos (α = 0.04)\n")
}
# Extraer métricas clave
r_cuadrado <- summary(modelo_reg)$r.squared
r_cuadrado_adj <- summary(modelo_reg)$adj.r.squared
f_estadistico <- summary(modelo_reg)$fstatistic
p_valor_modelo <- pf(f_estadistico[1], f_estadistico[2], f_estadistico[3], lower.tail = FALSE)
cat("=== RESUMEN DEL MODELO ===\n\n")
cat(sprintf("R² = %.4f (%.2f%% de la varianza explicada)\n", r_cuadrado, r_cuadrado * 100))
cat(sprintf("R² ajustado = %.4f\n", r_cuadrado_adj))
cat(sprintf("F-estadístico = %.4f, p-valor < 0.001\n", f_estadistico[1]))
cat(sprintf("Número de observaciones: %d\n", nrow(datos_regresion)))
# Crear variable categórica para niveles de uso nocturno
datos_anova <- DF %>%
filter(!is.na(dias_redes_antes_de_dormir), !is.na(horas_sueño_xnoche)) %>%
mutate(
nivel_uso_nocturno = case_when(
dias_redes_antes_de_dormir >= 0 & dias_redes_antes_de_dormir <= 2 ~ "Bajo (0-2 días)",
dias_redes_antes_de_dormir >= 3 & dias_redes_antes_de_dormir <= 4 ~ "Moderado (3-4 días)",
dias_redes_antes_de_dormir >= 5 & dias_redes_antes_de_dormir <= 7 ~ "Alto (5-7 días)",
TRUE ~ NA_character_
)
) %>%
filter(!is.na(nivel_uso_nocturno)) %>%
mutate(nivel_uso_nocturno = factor(nivel_uso_nocturno,
levels = c("Bajo (0-2 días)", "Moderado (3-4 días)", "Alto (5-7 días)")))
# Verificar tamaños de grupo
table(datos_anova$nivel_uso_nocturno)
# Estadísticas descriptivas por grupo
estadisticas_grupos <- datos_anova %>%
group_by(nivel_uso_nocturno) %>%
summarise(
n = n(),
Media = mean(horas_sueño_xnoche, na.rm = TRUE),
Mediana = median(horas_sueño_xnoche, na.rm = TRUE),
Desv_Est = sd(horas_sueño_xnoche, na.rm = TRUE),
Varianza = var(horas_sueño_xnoche, na.rm = TRUE),
Min = min(horas_sueño_xnoche, na.rm = TRUE),
Max = max(horas_sueño_xnoche, na.rm = TRUE),
Error_Est = sd(horas_sueño_xnoche, na.rm = TRUE) / sqrt(n())
)
kable(estadisticas_grupos, digits = 3,
caption = "Tabla 4: Estadísticas descriptivas de horas de sueño por nivel de uso nocturno de redes",
col.names = c("Nivel de Uso Nocturno", "n", "Media", "Mediana", "Desv. Est.",
"Varianza", "Mín", "Máx", "Error Est.")) %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed", "responsive"),
full_width = TRUE, font_size = 12) %>%
row_spec(0, bold = TRUE, color = "white", background = "#3498db")
# Boxplot comparativo
ggplot(datos_anova, aes(x = nivel_uso_nocturno, y = horas_sueño_xnoche, fill = nivel_uso_nocturno)) +
geom_boxplot(alpha = 0.7, outlier.color = "red") +
geom_jitter(width = 0.2, alpha = 0.3, size = 1.5) +
stat_summary(fun = mean, geom = "point", shape = 23, size = 4,
fill = "white", color = "black", stroke = 1.5) +
labs(title = "Distribución de Horas de Sueño por Nivel de Uso Nocturno de Redes Sociales",
subtitle = "El rombo blanco representa la media de cada grupo",
x = "Nivel de Uso Nocturno de Redes Sociales",
y = "Horas de Sueño por Noche",
fill = "Grupo") +
scale_fill_manual(values = c("#27ae60", "#f39c12", "#e74c3c")) +
theme_minimal() +
theme(legend.position = "none",
plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
plot.subtitle = element_text(hjust = 0.5, size = 10),
axis.text.x = element_text(angle = 0, hjust = 0.5))
# Prueba de Shapiro-Wilk por grupo
normalidad_tests <- datos_anova %>%
group_by(nivel_uso_nocturno) %>%
summarise(
n = n(),
Shapiro_W = shapiro.test(horas_sueño_xnoche)$statistic,
p_valor = shapiro.test(horas_sueño_xnoche)$p.value,
Normal = ifelse(shapiro.test(horas_sueño_xnoche)$p.value > 0.04, "Sí", "No")
)
kable(normalidad_tests, digits = 4,
caption = "Tabla 5: Pruebas de normalidad (Shapiro-Wilk) por grupo",
col.names = c("Grupo", "n", "Estadístico W", "p-valor", "¿Normal? (α=0.04)")) %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"),
full_width = FALSE, font_size = 12) %>%
row_spec(0, bold = TRUE, color = "white", background = "#3498db")
# Q-Q plots por grupo
par(mfrow = c(1, 3))
for (grupo in levels(datos_anova$nivel_uso_nocturno)) {
datos_grupo <- datos_anova %>% filter(nivel_uso_nocturno == grupo)
qqnorm(datos_grupo$horas_sueño_xnoche, main = paste("Q-Q Plot:", grupo))
qqline(datos_grupo$horas_sueño_xnoche, col = "red")
}
# Prueba de Levene para homogeneidad de varianzas
levene_test <- leveneTest(horas_sueño_xnoche ~ nivel_uso_nocturno, data = datos_anova)
cat("Prueba de Levene para homogeneidad de varianzas:\n")
print(levene_test)
if (levene_test$`Pr(>F)`[1] > 0.04) {
cat("\nConclusión: No rechazamos H₀. Las varianzas son homogéneas entre grupos (α = 0.04)\n")
cat("✓ Se cumple el supuesto de homocedasticidad para ANOVA\n")
} else {
cat("\nConclusión: Rechazamos H₀. Las varianzas NO son homogéneas entre grupos (α = 0.04)\n")
cat("✗ Considerar prueba no paramétrica (Kruskal-Wallis) o Welch ANOVA\n")
}
# Prueba alternativa: Bartlett (más sensible a no-normalidad)
bartlett_test <- bartlett.test(horas_sueño_xnoche ~ nivel_uso_nocturno, data = datos_anova)
cat("\nPrueba de Bartlett para homogeneidad de varianzas:\n")
cat(sprintf("Estadístico de Bartlett = %.4f, p-valor = %.4f\n",
bartlett_test$statistic, bartlett_test$p.value))
# Ajustar modelo ANOVA
modelo_anova <- aov(horas_sueño_xnoche ~ nivel_uso_nocturno, data = datos_anova)
# Tabla ANOVA
anova_summary <- summary(modelo_anova)
print(anova_summary)
# Extraer componentes de la tabla ANOVA
anova_table <- anova_summary[[1]]
# Calcular componentes manualmente para verificación
media_global <- mean(datos_anova$horas_sueño_xnoche)
n_total <- nrow(datos_anova)
k <- length(levels(datos_anova$nivel_uso_nocturno))  # número de grupos
# Suma de cuadrados entre grupos (SCE)
SC_entre <- sum(estadisticas_grupos$n * (estadisticas_grupos$Media - media_global)^2)
# Suma de cuadrados dentro de grupos (SCD)
SC_dentro <- sum((estadisticas_grupos$n - 1) * estadisticas_grupos$Varianza)
# Suma de cuadrados total
SC_total <- SC_entre + SC_dentro
# Grados de libertad
gl_entre <- k - 1
gl_dentro <- n_total - k
gl_total <- n_total - 1
# Cuadrados medios
MC_entre <- SC_entre / gl_entre
MC_dentro <- SC_dentro / gl_dentro
# Estadístico F
F_stat <- MC_entre / MC_dentro
# p-valor
p_valor <- pf(F_stat, gl_entre, gl_dentro, lower.tail = FALSE)
# Crear tabla ANOVA formateada
tabla_anova_completa <- data.frame(
Fuente = c("Entre grupos (Factor)", "Dentro de grupos (Error)", "Total"),
SC = c(SC_entre, SC_dentro, SC_total),
gl = c(gl_entre, gl_dentro, gl_total),
MC = c(MC_entre, MC_dentro, NA),
F = c(F_stat, NA, NA),
p_valor = c(p_valor, NA, NA)
)
kable(tabla_anova_completa, digits = 4,
caption = "Tabla 6: Tabla ANOVA completa - Efecto del uso nocturno de redes en horas de sueño",
col.names = c("Fuente de Variación", "Suma de Cuadrados", "Grados de Libertad",
"Cuadrado Medio", "F", "p-valor")) %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed", "responsive"),
full_width = TRUE, font_size = 12) %>%
row_spec(0, bold = TRUE, color = "white", background = "#3498db") %>%
row_spec(3, bold = TRUE)
# Prueba de Tukey HSD (Honest Significant Difference) al 96% de confianza
tukey_result <- TukeyHSD(modelo_anova, conf.level = 0.96)
print(tukey_result)
# Visualización de intervalos de confianza de Tukey
plot(tukey_result, las = 1, col = "blue")
title(main = "Intervalos de Confianza (96%) para Comparaciones Múltiples - Tukey HSD")
abline(v = 0, lty = 2, col = "red")
# Tabla formateada de comparaciones de Tukey
tukey_df <- as.data.frame(tukey_result$nivel_uso_nocturno)
tukey_df$Comparacion <- rownames(tukey_df)
tukey_df$Significativo <- ifelse(tukey_df$`p adj` < 0.04, "Sí", "No")
tukey_tabla <- tukey_df %>%
select(Comparacion, diff, lwr, upr, `p adj`, Significativo)
kable(tukey_tabla, digits = 4,
caption = "Tabla 7: Comparaciones múltiples de Tukey (α = 0.04)",
col.names = c("Comparación", "Diferencia de Medias", "Límite Inferior (96%)",
"Límite Superior (96%)", "p-valor ajustado", "¿Significativo?")) %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed", "responsive"),
full_width = TRUE, font_size = 12) %>%
row_spec(0, bold = TRUE, color = "white", background = "#3498db")
# Gráfico de medias con intervalos de confianza
medias_ic <- datos_anova %>%
group_by(nivel_uso_nocturno) %>%
summarise(
media = mean(horas_sueño_xnoche),
n = n(),
sd = sd(horas_sueño_xnoche),
se = sd / sqrt(n),
# IC al 96% = media ± t(0.98, n-1) * se
ic_inferior = media - qt(0.98, n-1) * se,
ic_superior = media + qt(0.98, n-1) * se
)
ggplot(medias_ic, aes(x = nivel_uso_nocturno, y = media, fill = nivel_uso_nocturno)) +
geom_bar(stat = "identity", alpha = 0.7, width = 0.6) +
geom_errorbar(aes(ymin = ic_inferior, ymax = ic_superior),
width = 0.2, size = 1, color = "black") +
geom_text(aes(label = sprintf("%.2f", media)),
vjust = -0.5, size = 4, fontface = "bold") +
labs(title = "Medias de Horas de Sueño por Nivel de Uso Nocturno de Redes",
subtitle = "Barras de error representan intervalos de confianza al 96%",
x = "Nivel de Uso Nocturno de Redes Sociales",
y = "Promedio de Horas de Sueño por Noche") +
scale_fill_manual(values = c("#27ae60", "#f39c12", "#e74c3c")) +
theme_minimal() +
theme(legend.position = "none",
plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
plot.subtitle = element_text(hjust = 0.5, size = 10))
# Extraer residuos y valores ajustados
residuos <- residuals(modelo_anova)
valores_ajustados <- fitted(modelo_anova)
# Gráficos de diagnóstico
par(mfrow = c(2, 2))
# 1. Residuos vs Valores Ajustados
plot(valores_ajustados, residuos,
xlab = "Valores Ajustados", ylab = "Residuos",
main = "Residuos vs Valores Ajustados")
abline(h = 0, col = "red", lty = 2)
# 2. Q-Q Plot de residuos
qqnorm(residuos, main = "Q-Q Plot de Residuos")
qqline(residuos, col = "red")
# 3. Scale-Location
plot(valores_ajustados, sqrt(abs(residuos)),
xlab = "Valores Ajustados", ylab = "√|Residuos|",
main = "Scale-Location")
# 4. Residuos vs Orden
plot(residuos, type = "b",
xlab = "Índice", ylab = "Residuos",
main = "Residuos vs Orden de Observación")
abline(h = 0, col = "red", lty = 2)
# Prueba de normalidad de residuos del modelo completo
shapiro_residuos <- shapiro.test(residuos)
cat("Prueba de Shapiro-Wilk para residuos del modelo ANOVA:\n")
cat(sprintf("Estadístico W = %.4f, p-valor = %.4f\n",
shapiro_residuos$statistic, shapiro_residuos$p.value))
if (shapiro_residuos$p.value > 0.04) {
cat("Conclusión: Los residuos siguen una distribución normal (α = 0.04)\n")
} else {
cat("Conclusión: Los residuos NO siguen una distribución normal (α = 0.04)\n")
}
cat("=== RESULTADOS DEL ANOVA ===\n\n")
cat(sprintf("F-estadístico = %.4f\n", F_stat))
cat(sprintf("p-valor = %.6f\n", p_valor))
cat(sprintf("Nivel de significancia: α = 0.04\n\n"))
if (p_valor < 0.04) {
cat("DECISIÓN: Rechazamos la hipótesis nula (H₀)\n\n")
cat("CONCLUSIÓN: Existen diferencias estadísticamente significativas en las horas de sueño\n")
cat("promedio entre al menos dos de los grupos de uso nocturno de redes sociales.\n\n")
cat("Esto significa que el nivel de uso nocturno de redes sociales SÍ tiene un efecto\n")
cat("significativo sobre la cantidad de horas de sueño de los estudiantes universitarios.\n")
} else {
cat("DECISIÓN: No rechazamos la hipótesis nula (H₀)\n\n")
cat("CONCLUSIÓN: No existe evidencia estadística suficiente para afirmar que hay diferencias\n")
cat("significativas en las horas de sueño promedio entre los grupos de uso nocturno de redes.\n")
}
for (i in 1:nrow(tukey_tabla)) {
cat(sprintf("\n• %s:\n", tukey_tabla$Comparacion[i]))
cat(sprintf("  Diferencia de medias: %.3f horas\n", tukey_tabla$`Diferencia de Medias`[i]))
cat(sprintf("  IC 96%%: [%.3f, %.3f]\n",
tukey_tabla$`Límite Inferior (96%)`[i],
tukey_tabla$`Límite Superior (96%)`[i]))
cat(sprintf("  p-valor ajustado: %.4f\n", tukey_tabla$`p-valor ajustado`[i]))
if (tukey_tabla$Significativo[i] == "Sí") {
if (tukey_tabla$`Diferencia de Medias`[i] > 0) {
grupos <- strsplit(as.character(tukey_tabla$Comparacion[i]), "-")[[1]]
cat(sprintf("  → El grupo '%s' duerme significativamente MÁS que '%s'\n",
trimws(grupos[1]), trimws(grupos[2])))
} else {
grupos <- strsplit(as.character(tukey_tabla$Comparacion[i]), "-")[[1]]
cat(sprintf("  → El grupo '%s' duerme significativamente MENOS que '%s'\n",
trimws(grupos[1]), trimws(grupos[2])))
}
} else {
cat("  → No hay diferencia significativa entre estos grupos\n")
}
}
